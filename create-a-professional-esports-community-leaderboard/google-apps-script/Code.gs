function writeResults_(ss,results){const s=sheet_(ss,TABS.RESULTS);ensure_(s,HEADERS[TABS.RESULTS]);const normalized=(results||[]).map(normalizeResult_).filter(Boolean);if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,HEADERS[TABS.RESULTS].length).clearContent();const out=normalized.map(r=>[r.resultId,r.eventId,r.eventName,r.teamId,r.teamName,r.position,r.kills,r.booyahs,r.positionPoints,r.killPoints,r.totalPoints,r.proofUrl,r.verified,r.updatedAt]);if(out.length)s.getRange(2,1,out.length,HEADERS[TABS.RESULTS].length).setValues(out);return normalized;}
