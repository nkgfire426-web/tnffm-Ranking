function readRankings_(ss){const s=sheet_(ss,TABS.RANKINGS);ensure_(s,HEADERS[TABS.RANKINGS]);return rows_(s).filter(r=>clean_(r[2])).map(r=>({rank:int_(r[0]),teamId:clean_(r[1]),teamName:clean_(r[2]),slug:clean_(r[3]),eventsPlayed:int_(r[4]),championships:int_(r[5]),runnerUp:int_(r[6]),secondRunnerUp:int_(r[7]),top5Finishes:int_(r[8]),communityScore:num_(r[9]),kills:int_(r[10]),booyahs:int_(r[11]),killRatio:num_(r[12]),booyahRatio:num_(r[13]),positionPoints:num_(r[14]),totalPoints:num_(r[15]),matchesPlayed:int_(r[16]),grandFinals:int_(r[17]),winRate:num_(r[18]),eligible:clean_(r[19])||'Yes',status:clean_(r[20])||'Active',updatedAt:clean_(r[21])}));}
