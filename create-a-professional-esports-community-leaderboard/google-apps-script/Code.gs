function writeObjects_(ss,name,objects){const sheet=getOrCreateSheet_(ss,name);sheet.clearContents();if(!objects||!objects.length)return;const headers=[];objects.forEach(o=>Object.keys(o||{}).forEach(k=>{if(headers.indexOf(k)<0)headers.push(k);}));const rows=objects.map(o=>headers.map(k=>{const v=o[k];return v==null?"":typeof v==="object"?JSON.stringify(v):v;}));sheet.getRange(1,1,1,headers.length).setValues([headers]);sheet.getRange(2,1,rows.length,headers.length).setValues(rows);sheet.setFrozenRows(1);}
